# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings → API).
#
# Ambos os valores abaixo são PÚBLICOS por design — são protegidos pelo Row
# Level Security do banco, não por sigilo da chave. Nunca coloque a chave
# "service_role" aqui nem em nenhum outro lugar do código do navegador.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
